struct P {
	x : i32;
	y : i32;
}

struct S { a : i32[4]; }

arr g : i32[6] = {[3] = 5, [5] = 3};
arr gm : i32[][] = {[1][2] = 7, [0][0] = 1};
var gs : S = {.a = {[2] = 9}};
arr gt : i8[2][4] = {[1] = "hi"};

pub fn main() : i64 {
	arr a : i32[6] = {[3] = 5, [5] = 3};
	arr m : i32[2][3] = {[1][2] = 7, [0][0] = 1};
	arr n : i32[3][3] = {[2] = {1, 2, 3}, [0] = {4, 5, 6}};
	arr s : i8[2][4] = {[1] = "hi"};
	arr p : P[3] = {[1] = {.x = 5}};
	static arr st : i32[4] = {[2] = 9};
	var sv : S = {.a = {[2] = 9}};
	arr q : i32[2][2] = {[1] = {[0] = 5}};
	var lg : i64 = g.len;
	var lgi : i64 = gm.len;
	var lr : i64 = gm[0].len;

	if (a[3] != 5 || a[5] != 3) { return 1; }
	if (a[0] + a[1] + a[2] + a[4] != 0) { return 2; }
	if (m[0][0] != 1 || m[1][2] != 7) { return 3; }
	if (m[0][1] + m[1][0] + m[0][2] + m[1][1] != 0) { return 4; }
	if (n[0][0] != 4 || n[0][2] != 6 || n[2][0] != 1 || n[2][2] != 3) { return 5; }
	if (n[1][0] + n[1][1] + n[1][2] != 0) { return 6; }
	if (s[1][0] != 104 || s[1][1] != 105 || s[1][2] != 0 || s[1][3] != 0) { return 7; }
	if (s[0][0] + s[0][1] + s[0][2] + s[0][3] != 0) { return 8; }
	if (p[1].x != 5 || p[1].y != 0 || p[0].x != 0 || p[2].x != 0) { return 9; }
	if (st[2] != 9 || st[0] + st[1] + st[3] != 0) { return 10; }
	if (sv.a[2] != 9 || sv.a[0] + sv.a[1] + sv.a[3] != 0) { return 11; }
	if (lg != 6 || g[3] != 5 || g[5] != 3 || g[0] + g[1] + g[2] + g[4] != 0) { return 12; }
	if (lgi != 2 || lr != 3 || gm[1][2] != 7 || gm[0][0] != 1) { return 13; }
	if (gm[0][1] + gm[0][2] + gm[1][0] + gm[1][1] != 0) { return 14; }
	if (gs.a[2] != 9 || gs.a[0] + gs.a[1] + gs.a[3] != 0) { return 15; }
	if (gt[1][0] != 104 || gt[1][1] != 105 || gt[0][0] + gt[1][2] + gt[1][3] != 0) { return 16; }
	if (q[1][0] != 5 || q[0][0] + q[0][1] + q[1][1] != 0) { return 17; }
	return 0;
}
